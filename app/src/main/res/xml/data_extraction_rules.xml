<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device, by backup or by transfer to a new phone. The app's files include the ADB key used
    for the fast-mode setup, which is only meaningful on the phone that was paired, and the settings are quick to
    set again. allowBackup="false" alone does not stop a device-to-device transfer on Android 12 and later.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>